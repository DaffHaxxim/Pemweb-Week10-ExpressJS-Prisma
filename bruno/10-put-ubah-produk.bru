meta {
  name: 10 PUT ubah produk (sukses)
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": {{spidolId}},
    "name": "Spidol Hitam",
    "price": 9000
  }
}

assert {
  res.status: eq 200
}
