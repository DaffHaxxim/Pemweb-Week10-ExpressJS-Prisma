meta {
  name: 02 POST produk Spidol (sukses)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Spidol",
    "price": 8000
  }
}

vars:post-response {
  spidolId: res.body.id
}

assert {
  res.status: eq 201
}
