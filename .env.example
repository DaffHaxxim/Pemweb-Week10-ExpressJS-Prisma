# Salin file ini menjadi .env lalu ganti USER dan PASSWORD. Jangan commit .env.
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=pemweb_products

# Dipakai Prisma CLI (prisma.config.ts) dan aplikasi (src/lib/prisma.ts).
# Nilai USER, PASSWORD, dan nama database harus sama dengan di atas.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pemweb_products"

# Port server Express (opsional, bawaan 3000).
PORT=3000
